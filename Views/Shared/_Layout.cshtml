<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MovieHub</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark moviehub-navbar shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4" asp-controller="Home" asp-action="Index">
                    🎬 MovieHub
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Головна</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Movies" asp-action="Index">Фільми</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Reviews" asp-action="Index">Відгуки</a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reviews" asp-action="MyReviews">Мої відгуки</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Ratings" asp-action="MyRatings">Мої оцінки</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Watchlists" asp-action="Index">Мій Watchlist</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="UserMovies" asp-action="Index">Мої фільми</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Profile" asp-action="Index">Профіль</a>
                            </li>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Панель</a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Genres" asp-action="Index">Жанри</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="StreamingProviders" asp-action="Index">Стрімінги</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-warning fw-semibold">Привіт, @User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link nav-link border-0 bg-transparent">
                                        Вихід
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">Реєстрація</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Вхід</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="main-wrapper">
        <div class="container py-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success shadow-sm rounded-3">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger shadow-sm rounded-3">
                    @TempData["ErrorMessage"]
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <footer class="moviehub-footer mt-5">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center py-3">
                <div>© 2026 - MovieHub</div>
                <div class="text-light-emphasis">Система перегляду фільмів, відгуків та персональних колекцій</div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>