@model MovieHub.Models.Review

@{
    ViewData["Title"] = "Деталі відгуку";
}

<h1>Деталі відгуку</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Текст</dt>
        <dd class="col-sm-10">@Model.Text</dd>

        <dt class="col-sm-2">Дата</dt>
        <dd class="col-sm-10">@Model.CreatedAt</dd>

        <dt class="col-sm-2">Фільм</dt>
        <dd class="col-sm-10">@Model.Movie?.Title</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редагувати</a>
<a asp-action="Index" class="btn btn-secondary">Назад</a>