@model MovieHub.Models.StreamingProvider

@{
    ViewData["Title"] = "Деталі сервісу";
}

<h1>Деталі сервісу</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Назва</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Посилання</dt>
        <dd class="col-sm-10">
            <a href="@Model.Url" target="_blank">@Model.Url</a>
        </dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редагувати</a>
<a asp-action="Index" class="btn btn-secondary">Назад</a>