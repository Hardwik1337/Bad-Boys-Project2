@model MovieHub.Models.Rating

@{
    ViewData["Title"] = "Редагувати оцінку";
}

<h1>Редагувати оцінку</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Score" class="control-label">Оцінка</label>
        <input asp-for="Score" class="form-control" />
        <span asp-validation-for="Score" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MovieId" class="control-label">Фільм</label>
        <select asp-for="MovieId" class="form-control" asp-items="ViewBag.MovieId"></select>
        <span asp-validation-for="MovieId" class="text-danger"></span>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>