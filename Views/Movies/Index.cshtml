@model IEnumerable<MovieHub.Models.Movie>

@{
    ViewData["Title"] = "Фільми";
}

<h1 class="mb-4">Фільми</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Створити новий фільм</a>
    </p>
}

<div class="row g-4">
    @foreach (var movie in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100 p-3">
                <div class="card-body d-flex flex-column">
                    <h4 class="card-title">@movie.Title</h4>
                    <p class="mb-2"><strong>Жанр:</strong> @movie.Genre?.Name</p>
                    <p class="mb-2"><strong>Рік:</strong> @movie.ReleaseYear</p>
                    <p class="card-text flex-grow-1">@movie.Description</p>

                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-outline-primary">
                            Деталі
                        </a>

                        @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                        {
                            <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-outline-warning">
                                Редагувати
                            </a>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-outline-danger">
                                Видалити
                            </a>
                        }

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Watchlists"
                               asp-action="AddMovie"
                               asp-route-movieId="@movie.Id"
                               class="btn btn-success">
                                Додати в Watchlist
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>