@model MovieHub.Models.Movie

@{
    ViewData["Title"] = "Деталі фільму";
}

<h1>Деталі фільму</h1>
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <a asp-controller="Watchlists"
       asp-action="AddMovie"
       asp-route-movieId="@Model.Id"
       class="btn btn-primary">
        Додати в Watchlist
    </a>
}
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Назва</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Опис</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">Рік</dt>
        <dd class="col-sm-10">@Model.ReleaseYear</dd>

        <dt class="col-sm-2">Жанр</dt>
        <dd class="col-sm-10">@Model.Genre?.Name</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редагувати</a>
<a asp-action="Index" class="btn btn-secondary">Назад</a>