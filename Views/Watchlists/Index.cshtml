@model IEnumerable<MovieHub.Models.Watchlist>

@{
    ViewData["Title"] = "Мій Watchlist";
}

<h1 class="mb-4">Мій Watchlist</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">
        У тебе ще немає жодного списку.
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Створити список
    </a>
}
else
{
    <p class="mb-4">
        <a asp-action="Create" class="btn btn-primary">Створити новий список</a>
    </p>

    <div class="row g-4">
        @foreach (var watchlist in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 p-3">
                    <div class="card-body d-flex flex-column">
                        <h4 class="card-title">@watchlist.Name</h4>
                        <p class="mb-3">
                            <strong>Фільмів у списку:</strong> @watchlist.Items.Count
                        </p>

                        <div class="d-flex gap-2 flex-wrap mt-auto">
                            <a asp-action="Details" asp-route-id="@watchlist.Id" class="btn btn-outline-primary">
                                Відкрити
                            </a>
                            <a asp-action="Edit" asp-route-id="@watchlist.Id" class="btn btn-outline-warning">
                                Редагувати
                            </a>
                            <a asp-action="Delete" asp-route-id="@watchlist.Id" class="btn btn-outline-danger">
                                Видалити
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}