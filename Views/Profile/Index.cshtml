@model MovieHub.Models.ApplicationUser

@{
    ViewData["Title"] = "Профіль";
    var roles = ViewBag.Roles as IList<string>;
}

<h1>Профіль користувача</h1>

<div class="card mt-3">
    <div class="card-body">
        <h4 class="card-title">@Model.FullName</h4>
        <p><strong>Ім'я користувача:</strong> @Model.UserName</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p>
            <strong>Ролі:</strong>
            @if (roles != null && roles.Any())
            {
                @string.Join(", ", roles)
            }
            else
            {
                <span>Немає ролей</span>
            }
        </p>
    </div>
</div>