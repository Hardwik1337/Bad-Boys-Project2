@model IEnumerable<MovieHub.Models.Rating>

@{
    ViewData["Title"] = "Оцінки";
}

<h1 class="mb-4">Мої оцінки</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">
        У тебе ще немає оцінок.
    </div>

    <a asp-controller="Movies" asp-action="Index" class="btn btn-primary">
        Перейти до фільмів
    </a>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 p-3">
                    <div class="card-body d-flex flex-column">
                        <h4 class="card-title">@item.Movie?.Title</h4>
                        <p class="mb-2"><strong>Оцінка:</strong> @item.Score / 10</p>
                        <p class="mb-3"><strong>Користувач:</strong> @item.User?.UserName</p>

                        <div class="d-flex gap-2 flex-wrap mt-auto">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">
                                Деталі
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning">
                                Редагувати
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">
                                Видалити
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}