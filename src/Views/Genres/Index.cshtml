@model IEnumerable<MovieHub.Models.Genre>

@{
    ViewData["Title"] = "Жанри";
}

<h1 class="mb-4">Жанри</h1>

<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text"
               name="searchString"
               value="@ViewData["CurrentFilter"]"
               placeholder="Пошук жанру за назвою"
               class="form-control" />

        <button type="submit" class="btn btn-primary">Пошук</button>
        <a asp-action="Index" class="btn btn-secondary">Очистити</a>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">Створити новий жанр</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Назва</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Деталі</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Редагувати</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Видалити</a>
                </td>
            </tr>
        }
    </tbody>
</table>