@model MovieHub.Models.Watchlist

@{
    ViewData["Title"] = "Деталі списку";
}

<h1 class="mb-4">@Model.Name</h1>

<div class="mb-4">
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редагувати</a>
</div>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        У цьому списку ще немає фільмів.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model.Items)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 p-3">
                    <div class="card-body d-flex flex-column">
                        <h4 class="card-title">@item.Movie?.Title</h4>
                        <p class="text-muted mb-3">
                            Додано: @item.AddedAt.ToString("dd.MM.yyyy HH:mm")
                        </p>

                        <form asp-action="RemoveMovie" method="post" class="mt-auto">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="itemId" value="@item.Id" />
                            <button type="submit" class="btn btn-danger">
                                Видалити зі списку
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}