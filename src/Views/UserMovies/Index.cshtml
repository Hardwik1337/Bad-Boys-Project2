@model IEnumerable<MovieHub.Controllers.UserMovieListItemViewModel>

@{
    ViewData["Title"] = "Мої фільми";
}

<h1 class="mb-4">Мої фільми</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">
        У твоїй персональній базі ще немає фільмів.
    </div>

    <a asp-controller="Movies" asp-action="Index" class="btn btn-primary">
        Перейти до каталогу
    </a>
}
else
{
    <div class="row g-4">
        @foreach (var movie in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 p-3">
                    <div class="card-body d-flex flex-column">
                        <h4 class="card-title">@movie.Title</h4>
                        <p><strong>Жанр:</strong> @movie.GenreName</p>
                        <p><strong>Рік:</strong> @movie.ReleaseYear</p>
                        <p class="card-text flex-grow-1">@movie.Description</p>
                        <p class="text-muted mb-3">
                            Додано: @movie.AddedAt.ToString("dd.MM.yyyy HH:mm")
                        </p>

                        <div class="d-flex gap-2 flex-wrap mt-auto">
                            <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.MovieId" class="btn btn-outline-primary">
                                Деталі
                            </a>

                            <form asp-action="Remove" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="movieId" value="@movie.MovieId" />
                                <button type="submit" class="btn btn-danger">
                                    Видалити
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}