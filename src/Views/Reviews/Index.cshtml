@model IEnumerable<MovieHub.Models.Review>

@{
    ViewData["Title"] = "Відгуки";
}

<h1 class="mb-4">Мої відгуки</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">
        У тебе ще немає відгуків.
    </div>

    <a asp-controller="Movies" asp-action="Index" class="btn btn-primary">
        Перейти до фільмів
    </a>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 p-3">
                    <div class="card-body d-flex flex-column">
                        <h4 class="card-title">@item.Movie?.Title</h4>
                        <p class="card-text flex-grow-1">@item.Text</p>
                        <p class="text-muted mb-3">
                            @item.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </p>

                        <div class="d-flex gap-2 flex-wrap mt-auto">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">
                                Деталі
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning">
                                Редагувати
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">
                                Видалити
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}